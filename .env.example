# ==============================================================================
# IBM watsonx Orchestrate Environment Configuration
# ==============================================================================
# The base URL of your watsonx Orchestrate tenant instance
# Example for EU-DE: https://api.eu-de.watson-orchestrate.cloud.ibm.com/instances/<instance-id>
# Example for US-South: https://api.us-south.watson-orchestrate.cloud.ibm.com/instances/<instance-id>
WXO_INSTANCE_URL=https://api.eu-de.watson-orchestrate.cloud.ibm.com/instances/your-instance-id

# IBM Cloud IAM API Key with Editor / Administrator role on watsonx Orchestrate
WXO_API_KEY=your-ibm-cloud-iam-api-key

# Orchestrate CLI Environment Name (e.g. frankfurt-fresh, us-south-dev, etc.)
WXO_ENV_NAME=wxo-qwen-env

# ==============================================================================
# GPU Inference Runtimes (Modal Serverless or On-Premises Host)
# ==============================================================================
# vLLM Serverless / On-Prem Endpoint URL (OpenAI-compatible)
# Note: In WXO virtual-model provider_config, point to the /v1 base path
VLLM_HOST_URL=https://<your-modal-username>--vllm-qwen-orchestrate-serve.modal.run/v1
VLLM_API_KEY=qwen-orchestrate-token

# Ollama Serverless / On-Prem Endpoint URL
OLLAMA_HOST_URL=https://<your-modal-username>--ollama-qwen-orchestrate-serve.modal.run

# Connection App ID configured in WXO for credentials
CONNECTION_APP_ID=qwen_modal_creds

# ==============================================================================
# Remote MCP Toolkits
# ==============================================================================
# Tavily API Key for real-time AI web search, content extraction, and research
TAVILY_API_KEY=tvly-your-api-key-here
